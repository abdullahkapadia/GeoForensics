# ==============================================================================
# GeoForensics AI — Backend Environment Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="GeoForensics AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Multimodal Vision & Intelligence (Google AI Studio)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional: Google Maps Geocoding / Street View Enrichment
GOOGLE_MAPS_API_KEY=""

# Pipeline Scoring Weights (Must sum to ~1.0)
WEIGHT_EXIF_GPS=0.35
WEIGHT_LANDMARK=0.30
WEIGHT_OCR=0.25
WEIGHT_VISUAL_SIMILARITY=0.20
WEIGHT_GEOSPATIAL=0.15
WEIGHT_ARCHITECTURE=0.10
WEIGHT_ENVIRONMENT=0.08
WEIGHT_ROAD_MARKING=0.08

# Upload Constraints
MAX_UPLOAD_SIZE_MB=25
